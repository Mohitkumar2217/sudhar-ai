# Leave unset to run on local SQLite. Set to a Postgres URL for real deployment
# (see schema.sql for the reference DDL):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/revenuerescue
DATABASE_URL=

# Optional — omit to run the LLM-touched endpoints in offline/fallback mode 
# can use any other llm as per availablity just for help for copit
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional — omit to log dunning emails to the console instead of sending them
RESEND_API_KEY=
RESEND_FROM_ADDRESS=billing@sudhar.example

# Verifies Stripe-Signature headers on inbound webhooks (app/stripe_signature.py).
# In real Stripe this is the "signing secret" from your webhook endpoint settings.
# The default below only matters for local testing with scripts/send_test_webhook.py
# — replace it before pointing this at a real Stripe account.
STRIPE_WEBHOOK_SECRET=whsec_test_local_dev_secret

# Signs the 15-minute "update your payment method" magic links (app/magic_link.py).
# PORTAL_BASE_URL should point at the frontend's /update route.
MAGIC_LINK_SECRET=local_dev_magic_link_secret
PORTAL_BASE_URL=http://localhost:3000/update

# Off by default. Set to true to route retry timing through the trained model in
# app/retry_model.py instead of the retry_rules.py heuristic. That model is
# trained on SYNTHETIC data (see app/synthetic_retry_data.py and README Step 12)
# — read that before enabling this anywhere it matters.
RETRY_MODEL_ENABLED=false
